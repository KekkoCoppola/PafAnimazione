        features: [
          "Extra: Proiezione video (50€)",
          "Extra: Volo palloncini (2.5€ cad.)",
          "Extra: Quiz show personalizzato (100€)",
        ],
        icon: "fa6-solid:graduation-cap",
        tagColor: "yellow",
        image:
          "https://images.unsplash.com/photo-1511895426328-dc8714191300?auto=format&fit=crop&q=80&w=800",
        video: "",
      },
      {
        title: "Disco e fluo party",
        price: "150,00 €",
        desc: "Musica, karaoke gadget luminosi, trucco fluo, effetti speciali e tanto altro ancora per un party super adatto a bambini dai 7 ai 12 anni.",
        icon: "fa6-solid:music",
        tagColor: "orange",
        image:
          "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&q=80&w=800",
        video: "/video/FluoParty.mp4",
      },
      {
        title: "Laboratorio bombe da bagno",
        price: "150,00 €",
        desc: "Realizza la tua bomba da bagno personalizzata. Prezzo per un massimo di 10 bambini.",
        icon: "fa6-solid:flask",
        tagColor: "yellow",
        image:
          "https://images.unsplash.com/photo-1608248593842-8021c618eb7e?auto=format&fit=crop&q=80&w=800",
        video: "",
      },
      {
        title: "Pacchetto Party e Compleanni",
        price: "120,00 €",
        desc: "Servizio di intrattenimento della durata di 3 ore con 2 operatori, numero di bambini consigliato 18.",
        features: [
          "Accoglienza e Giochi",
          "Musica e Baby dance",
          "Mini Disco e Karaoke",
          "Teatrino e Palloncini",
        ],
        icon: "fa6-solid:cake-candles",
        tagColor: "yellow",
        image:
          "https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&q=80&w=800",
        video: "",
      },
    ],
  },
  {
    title: "SPETTACOLI",
    icon: "fa6-solid:masks-theater",
    items: [
      {
        title: "MAGIC SHOW",
        price: "150,00 €",
        desc: "Spettacolo di magia con ventriloquia, gag comiche e apparizione animale, durata 40 min.",
        icon: "fa6-solid:wand-magic-sparkles",
        tagColor: "orange",
        image:
          "https://images.unsplash.com/photo-1582213782179-e0d53f98f2ca?auto=format&fit=crop&q=80&w=800",
        video: "/video/Mago.mp4",
      },
    ],
  },
  {
    title: "GONFIABILI",
    icon: "fa6-solid:house-chimney",
    items: [
      {
        title: "Bubble house",
        price: "Da 130,00 €",
        desc: "Misure 2.5 x 3 per 2 altezza.",
        features: ["130€ prezzo compleanni", "160€ comunioni"],
        icon: "fa6-solid:house-chimney",
        tagColor: "yellow",
        image:
          "https://images.unsplash.com/photo-1535295972055-1c762f4483e5?auto=format&fit=crop&q=80&w=800",
        video: "",
      },
    ],
  },
  {
    title: "MASCOTTE",
    icon: "fa6-solid:paw",
    items: [
      {
        title: "SpiderMan",
        price: "70,00 €",
        desc: "SpiderMan in persona sarà il protagonista della tua festa, pronto a scatenare i bambini con foto balli e tanto divertimento.",
        icon: "fa6-solid:spider",
        tagColor: "yellow",
        image:
          "https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&q=80&w=800",
        video: "/video/Spiderman.mp4",
      },
      {
        title: "Orso",
        price: "60,00 €",
        desc: "L’orsacchiotto di Masha e Orso vi aspetta per festeggiare insieme ai bambini. ",
        icon: "fa6-solid:paw",
        tagColor: "yellow",
        image:
          "https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&q=80&w=800",
        video: "/video/Orso.mp4",
      },
      {
        title: "Mario Bros",
        price: "60,00 €",
        desc: "Mario Bros in persona sarà il protagonista della tua festa, pronto a scatenare i bambini con foto balli e tanto divertimento.",
        icon: "fa6-solid:gamepad",
        tagColor: "yellow",
        image: "/photos/MarioBros.webp",
        video: "",
      },
      {
        title: "Bing",
        price: "60,00 €",
        desc: "Bing sarà il protagonista della tua festa, pronto a scatenare i bambini con foto balli e tanto divertimento.",
        icon: "fa6-solid:carrot",
        tagColor: "yellow",
        image: "/photos/Bing.jpg",
        video: "",
      },
    ],
  },
];
---

<section class="catalogo" id="catalogo">
  <div class="container">
    <div class="cat-header reveal">
      <span class="section-tag"
        ><Icon
          name="fa6-solid:tent"
          style="display:inline;vertical-align:middle;margin-right:0.25rem;"
        /> Catalogo Servizi</span
      >
      <h2 class="section-title">La Nostra Offerta</h2>
      <p class="cat-subtitle">
        Sfoglia i nostri pacchetti, spettacoli e servizi speciali. C'è qualcosa
        per ogni occasione!
      </p>
    </div>

    <div class="cat-categories">
      {
        catalogCategories.map((category, catIndex) => (
          <div
            class="category-block reveal"
            style={`--delay: ${catIndex * 0.1}s`}
          >
            <div class="category-title-wrap">
              <h3 class="category-title">
                <Icon name={category.icon} /> {category.title}
              </h3>
              <div class="category-line" />
            </div>

            {category.items.length > 0 ? (
              <div class="cat-grid">
                {category.items.map((s) => (
                  <article class={`cat-card cat-card--${s.tagColor}`}>
                    {/* Media Background */}
                    <div class="cat-card-bg">
                      {s.video ? (
                        <video
                          src={s.video}
                          autoplay
                          loop
                          muted
                          playsinline
                          class="cat-media"
                        />
                      ) : (
                        <img
                          src={s.image}
                          alt={s.title}
                          class="cat-media"
                          loading="lazy"
                        />
                      )}
                      <div class="cat-overlay" />
                    </div>

                    {/* Card Content */}
                    <div class="cat-card-content">
                      <div class="cat-card-header">
                        <div class="cat-emoji">
                          <Icon name={s.icon} />
                        </div>
                        <div class={`cat-price cat-tag--${s.tagColor}`}>
                          {s.price}
                        </div>
                      </div>

                      <div class="cat-card-body">
                        <h4 class="cat-title">{s.title}</h4>
                        <p class="cat-desc">{s.desc}</p>

                        {s.features && (
                          <ul class="cat-features">
                            {s.features.map((f) => (
                              <li>
                                <Icon
                                  name="fa6-solid:check"
                                  class="feature-icon"
                                />{" "}
                                <span>{f}</span>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>

                      <div
                        class="cat-action-wrap"
                        style="margin-top: auto; padding-top: 1.5rem;"
                      >
                        <AddToCartButton
                          client:visible
                          item={{
                            id: s.title.toLowerCase().replace(/\s+/g, "-"),
                            title: s.title,
                            price: s.price,
                            icon: s.icon,
                            image: s.image,
                          }}
                        />
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <p>Nuovi arrivi in questa categoria a breve! ✨</p>
              </div>
            )}
          </div>
        ))
      }
    </div>

    <div class="cat-footer reveal">
      <p>Non trovi quello che cerchi o vuoi combinare più servizi?</p>
      <a href="#contatti" class="btn btn-secondary"
        >Contattaci per un'offerta personalizzata <Icon
          name="fa6-solid:wand-magic-sparkles"
          style="margin-left:0.5rem;"
        /></a
      >
    </div>
  </div>
</section>

<style>
  .catalogo {
    background: var(--gray-100);
    position: relative;
    overflow: hidden;
    padding-bottom: 6rem;
  }

  .cat-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }
  .cat-subtitle {
    color: var(--gray-600);
    margin-top: 0.75rem;
  }

  .cat-categories {
    display: flex;
    flex-direction: column;
    gap: 5rem;
    margin-bottom: 4rem;
    position: relative;
    z-index: 1;
  }

  .category-title-wrap {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .category-title {
    font-size: 2.2rem;
    color: var(--black);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
  }
  .category-line {
    height: 4px;
    background: var(--black);
    width: 100%;
    border-radius: 2px;
    opacity: 0.1;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  /* Premium Card Design */
  .cat-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 520px;
    box-shadow: var(--shadow-card);
    transition:
      transform 0.4s cubic-bezier(0.33, 1, 0.68, 1),
      box-shadow 0.4s ease;
    border: 4px solid var(--black);
    isolation: isolate;
    background: var(--black);
  }

  .cat-card:hover {
    transform: translateY(-8px);
    box-shadow: 16px 16px 0 var(--black);
  }
  .cat-card--yellow:hover {
    border-color: var(--yellow);
    box-shadow: 16px 16px 0 var(--yellow-dark);
  }
  .cat-card--orange:hover {
    border-color: var(--orange);
    box-shadow: 16px 16px 0 var(--orange-dark);
  }

  /* Background Media */
  .cat-card-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--black);
  }

  .cat-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.33, 1, 0.68, 1);
    filter: saturate(1.2) contrast(1.1);
  }

  .cat-card:hover .cat-media {
    transform: scale(1.08);
  }

  /* Glassmorphic Overlay */
  .cat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(26, 26, 26, 0.1) 0%,
      rgba(26, 26, 26, 0.6) 40%,
      rgba(26, 26, 26, 0.95) 100%
    );
    transition: opacity var(--transition);
  }

  .cat-card:hover .cat-overlay {
    background: linear-gradient(
      to bottom,
      rgba(26, 26, 26, 0.2) 0%,
      rgba(26, 26, 26, 0.7) 40%,
      rgba(26, 26, 26, 0.98) 100%
    );
  }

  /* Content Setup */
  .cat-card-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    position: relative;
    z-index: 2;
    color: var(--white);
  }

  .cat-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: auto; /* Pushes everything else down */
  }

  .cat-emoji {
    font-size: 2rem;
    line-height: 1;
    background: var(--white);
    color: var(--black);
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    box-shadow: 4px 4px 0 var(--black);
    border: 3px solid var(--black);
    transition: transform var(--transition-bounce);
  }
  .cat-card:hover .cat-emoji {
    transform: rotate(-10deg) scale(1.1);
  }

  .cat-price {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    padding: 0.4rem 1.2rem;
    border-radius: var(--radius-full);
    border: 2px solid var(--black);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.5);
    font-weight: bold;
  }
  .cat-tag--yellow {
    background: var(--yellow);
    color: var(--black);
  }
  .cat-tag--orange {
    background: var(--orange);
    color: var(--white);
  }
  .cat-tag--black {
    background: var(--black);
    color: var(--yellow);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .cat-card-body {
    margin-top: 2rem;
    margin-bottom: 1.5rem;
  }

  .cat-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--white);
    line-height: 1.1;
    margin-bottom: 0.75rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
  }
  .cat-desc {
    color: rgba(250, 250, 250, 0.9);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  }

  .cat-features {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }
  .cat-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(250, 250, 250, 0.8);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  }
  .feature-icon {
    color: var(--yellow);
    font-size: 0.9rem;
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .cat-link {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--yellow);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    background: rgba(26, 26, 26, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all var(--transition-bounce);
    margin-top: auto;
    align-self: flex-start;
  }
  .cat-link:hover {
    background: var(--yellow);
    color: var(--black);
    border-color: var(--black);
    gap: 0.8rem;
  }

  /* React Button Styles */
  :global(.cat-btn-add) {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--black);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-full);
    background: var(--yellow);
    border: 2px solid var(--black);
    box-shadow: 4px 4px 0 var(--black);
    transition: all var(--transition-bounce);
    cursor: pointer;
    font-weight: bold;
  }
  :global(.cat-btn-add:hover) {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--black);
  }
  :global(.cat-btn-add:active) {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--black);
  }
  :global(.cat-btn-add.is-in-cart) {
    background: var(--black);
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 4px 4px 0 rgba(255, 255, 255, 0.2);
  }
  :global(.cat-btn-add.is-in-cart:hover) {
    box-shadow: 6px 6px 0 rgba(255, 255, 255, 0.3);
  }

  .empty-state {
    padding: 3rem;
    text-align: center;
    background: rgba(255, 255, 255, 0.5);
    border: 2px dashed var(--gray-600);
    border-radius: var(--radius-lg);
    color: var(--gray-600);
    font-style: italic;
  }

  .cat-footer {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }
  .cat-footer p {
    color: var(--gray-600);
  }

  @media (max-width: 768px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }
    .category-title {
      font-size: 1.8rem;
    }
    .cat-card {
      min-height: 480px;
    }
  }
  /* React Button Styles */
  :global(.cat-btn-add) {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--black);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-full);
    background: var(--yellow);
    border: 2px solid var(--black);
    box-shadow: 4px 4px 0 var(--black);
    transition: all var(--transition-bounce);
    cursor: pointer;
    font-weight: bold;
  }
  :global(.cat-btn-add:hover) {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--black);
  }
  :global(.cat-btn-add:active) {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--black);
  }
  :global(.cat-btn-add.is-in-cart) {
    background: var(--black);
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 4px 4px 0 rgba(255, 255, 255, 0.2);
  }
  :global(.cat-btn-add.is-in-cart:hover) {
    box-shadow: 6px 6px 0 rgba(255, 255, 255, 0.3);
  }
</style>
