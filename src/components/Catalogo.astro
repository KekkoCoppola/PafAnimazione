---

<section class="catalogo" id="catalogo">
  <div class="container">
    <div class="cat-header reveal">
      <span class="section-tag"
        ><Icon
          name="fa6-solid:tent"
          style="display:inline;vertical-align:middle;margin-right:0.25rem;"
        /> Catalogo Servizi</span
      >
      <h2 class="section-title">La Nostra Offerta</h2>
      <p class="cat-subtitle">
        Sfoglia i nostri pacchetti, spettacoli e servizi speciali. C'è qualcosa
        per ogni occasione!
      </p>
    </div>

    <div class="cat-categories">
      {
        catalogCategories.map((category, catIndex) => (
          <div
            class="category-block reveal"
            style={`--delay: ${catIndex * 0.1}s`}
          >
            <div class="category-title-wrap">
              <h3 class="category-title">
                <Icon name={category.icon} /> {category.title}
              </h3>
              <div class="category-line" />
            </div>

            {category.items.length > 0 ? (
              <div class="cat-grid">
                {category.items.map((s) => (
                  <article class={`cat-card cat-card--${s.tagColor}`}>
                    {/* Media Background */}
                    <div class="cat-card-bg">
                      {s.video ? (
                        <video
                          src={s.video}
                          autoplay
                          loop
                          muted
                          playsinline
                          class="cat-media"
                        />
                      ) : (
                        <img
                          src={s.image}
                          alt={s.title}
                          class="cat-media"
                          loading="lazy"
                        />
                      )}
                      <div class="cat-overlay" />
                    </div>

                    {/* Card Content */}
                    <div class="cat-card-content">
                      <div class="cat-card-header">
                        <div class={`cat-price cat-tag--${s.tagColor}`}>
                          {s.price}
                        </div>
                      </div>

                      <div class="cat-card-body">
                        <h4 class="cat-title">{s.title}</h4>
                        <p class="cat-desc">{s.desc}</p>

                        {s.features && (
                          <ul class="cat-features">
                            {s.features.map((f) => (
                              <li>
                                <Icon
                                  name="fa6-solid:check"
                                  class="feature-icon"
                                />{" "}
                                <span>{f}</span>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>

                      <AddToCartButton
                        client:visible
                        item={{
                          id: s.title.toLowerCase().replace(/\s+/g, "-"),
                          title: s.title,
                          price: s.price,
                          icon: s.icon || "fa6-solid:gift",
                          image: s.image,
                        }}
                      />
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <p>Nuovi arrivi in questa categoria a breve! ✨</p>
              </div>
            )}
          </div>
        ))
      }
    </div>

    <div class="cat-footer reveal">
      <p>Non trovi quello che cerchi o vuoi combinare più servizi?</p>
      <a href="#contatti" class="btn btn-secondary"
        >Contattaci per un'offerta personalizzata <Icon
          name="fa6-solid:wand-magic-sparkles"
          style="margin-left:0.5rem;"
        /></a
      >
    </div>
  </div>
</section>

<style>
  .catalogo {
    background: var(--gray-100);
    position: relative;
    overflow: hidden;
    padding-bottom: 6rem;
  }

  .cat-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }
  .cat-subtitle {
    color: var(--gray-600);
    margin-top: 0.75rem;
  }

  .cat-categories {
    display: flex;
    flex-direction: column;
    gap: 5rem;
    margin-bottom: 4rem;
    position: relative;
    z-index: 1;
  }

  .category-title-wrap {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .category-title {
    font-size: 2.2rem;
    color: var(--black);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
  }
  .category-line {
    height: 4px;
    background: var(--black);
    width: 100%;
    border-radius: 2px;
    opacity: 0.1;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  /* Premium Card Design */
  .cat-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 520px;
    box-shadow: var(--shadow-card);
    transition:
      transform 0.4s cubic-bezier(0.33, 1, 0.68, 1),
      box-shadow 0.4s ease;
    border: 4px solid var(--black);
    isolation: isolate;
    background: var(--black);
  }

  .cat-card:hover {
    transform: translateY(-8px);
    box-shadow: 16px 16px 0 var(--black);
  }
  .cat-card--yellow:hover {
    border-color: var(--yellow);
    box-shadow: 16px 16px 0 var(--yellow-dark);
  }
  .cat-card--orange:hover {
    border-color: var(--orange);
    box-shadow: 16px 16px 0 var(--orange-dark);
  }

  /* Background Media */
  .cat-card-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--black);
  }

  .cat-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.33, 1, 0.68, 1);
    filter: saturate(1.2) contrast(1.1);
  }

  .cat-card:hover .cat-media {
    transform: scale(1.08);
  }

  /* Glassmorphic Overlay */
  .cat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(26, 26, 26, 0.1) 0%,
      rgba(26, 26, 26, 0.6) 40%,
      rgba(26, 26, 26, 0.95) 100%
    );
    transition: opacity var(--transition);
  }

  .cat-card:hover .cat-overlay {
    background: linear-gradient(
      to bottom,
      rgba(26, 26, 26, 0.2) 0%,
      rgba(26, 26, 26, 0.7) 40%,
      rgba(26, 26, 26, 0.98) 100%
    );
  }

  /* Content Setup */
  .cat-card-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    position: relative;
    z-index: 2;
    color: var(--white);
  }

  .cat-card-header {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 10;
    display: flex;
    justify-content: flex-end;
  }

  .cat-emoji {
    font-size: 2rem;
    line-height: 1;
    background: var(--white);
    color: var(--black);
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    box-shadow: 4px 4px 0 var(--black);
    border: 3px solid var(--black);
    transition: transform var(--transition-bounce);
  }
  .cat-card:hover .cat-emoji {
    transform: rotate(-10deg) scale(1.1);
  }

  .cat-price {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    padding: 0.4rem 1.2rem;
    border-radius: var(--radius-full);
    border: 2px solid var(--black);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.5);
    font-weight: bold;
  }
  .cat-tag--yellow {
    background: var(--yellow);
    color: var(--black);
  }
  .cat-tag--orange {
    background: var(--orange);
    color: var(--white);
  }
  .cat-tag--black {
    background: var(--black);
    color: var(--yellow);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .cat-card-body {
    margin-top: auto;
    margin-bottom: 0;
    width: calc(
      100% - 4rem
    ); /* Leave space on the right for the circle button */
  }

  .cat-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--white);
    line-height: 1.1;
    margin-bottom: 0.75rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
  }
  .cat-desc {
    color: rgba(250, 250, 250, 0.9);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  }

