---
import { Icon } from "astro-icon/components";
const navItems = [
  { label: "Chi Siamo", href: "#chi-siamo" },
  { label: "Catalogo", href: "#catalogo" },
  { label: "Organizza Evento", href: "#evento" },
  { label: "Dove Trovarci", href: "#dove" },
  { label: "Contatti", href: "#contatti" },
];
---

<footer class="footer">
  <div class="footer-top">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href={import.meta.env.BASE_URL} class="footer-logo-link" aria-label="Torna in cima">
          <img src={`${import.meta.env.BASE_URL}logo.jpg`} alt="Paf Animazione" width="80" height="80" />
        </a>
        <p class="footer-tagline">Portiamo la magia dove sei tu.</p>
        <div class="footer-social">
          <a
            href="https://instagram.com/paf_animazione"
            target="_blank"
            rel="noopener noreferrer"
            class="social-btn"
            aria-label="Instagram"><Icon name="fa6-brands:instagram" /></a
          >
          <a
            href="https://facebook.com/pafassociazione"
            target="_blank"
            rel="noopener noreferrer"
            class="social-btn"
            aria-label="Facebook"><Icon name="fa6-brands:facebook" /></a
          >
          <a
            href="mailto:info@pafanimazione.it"
            class="social-btn"
            aria-label="Email"><Icon name="fa6-solid:envelope" /></a
          >
          <a
            href="tel:+39 331 817 4419"
            class="social-btn"
            aria-label="Telefono"><Icon name="fa6-solid:phone" /></a
          >
        </div>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <h4>Navigazione</h4>
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-contact">
        <h4>Contatti Rapidi</h4>
        <ul>
          <li>
            <span><Icon name="fa6-solid:location-dot" /></span> Somma Vesuviana (NA),
            Campania
          </li>
          <li>
            <a href="tel:+39 331 817 4419"
              ><span><Icon name="fa6-solid:phone" /></span> +39 331 817 4419</a>
          </li>
          <li>
            <a href="mailto:info@pafanimazione.it"
              ><span><Icon name="fa6-solid:envelope" /></span> info@pafanimazione.it</a>
          </li>
          <li>
            <span><Icon name="fa6-solid:clock" /></span> Lun–Ven 15:00 – 20:00
          </li>
        </ul>
        <a href="#evento" class="btn btn-primary footer-cta"
          >Organizza il tuo Evento</a
        >
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>
        &copy; {new Date().getFullYear()} Paf Animazione — Tutti i diritti riservati.
      </p>
      <p class="footer-credits">
        Fatto con <Icon
          name="fa6-solid:heart"
          style="display:inline;color:var(--orange);vertical-align:middle;font-size:1.1rem;margin:0 0.2rem;"
        /> e tanta animazione
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--black);
    border-top: var(--border);
  }

  .footer-top {
    padding: 4rem 0 3rem;
    border-bottom: 2px solid rgba(255, 225, 53, 0.15);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.5fr;
    gap: 3rem;
  }

  /* Brand */
  .footer-logo-link img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    border-radius: 50%;
    border: 3px solid var(--yellow);
    transition: transform var(--transition-bounce);
  }
  .footer-logo-link:hover img {
    transform: rotate(-8deg) scale(1.1);
  }

  .footer-tagline {
    color: rgba(250, 250, 250, 0.6);
    margin: 1rem 0;
    font-size: 1rem;
    font-style: italic;
  }

  .footer-social {
    display: flex;
    gap: 0.75rem;
  }
  .social-btn {
    width: 42px;
    height: 42px;
    border: 2px solid rgba(255, 225, 53, 0.3);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: var(--white);
    transition: all var(--transition-bounce);
  }
  .social-btn:hover {
    background: var(--yellow);
    border-color: var(--yellow);
    color: var(--black);
    transform: translateY(-4px);
  }

  /* Nav */
  .footer-nav h4,
  .footer-contact h4 {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--yellow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .footer-nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-nav li a {
    color: rgba(250, 250, 250, 0.65);
    font-size: 0.95rem;
    transition:
      color var(--transition),
      padding-left var(--transition);
    display: inline-block;
  }
  .footer-nav li a:hover {
    color: var(--yellow);
    padding-left: 6px;
  }

  /* Contact */
  .footer-contact ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }
  .footer-contact li,
  .footer-contact li a {
    color: rgba(250, 250, 250, 0.65);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color var(--transition);
  }
  .footer-contact li a:hover {
    color: var(--yellow);
  }

  .footer-cta {
    font-size: 0.95rem;
    padding: 0.6rem 1.4rem;
  }

  /* Bottom */
  .footer-bottom {
    padding: 1.25rem 0;
  }
  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer-bottom p {
    color: rgba(250, 250, 250, 0.4);
    font-size: 0.8rem;
  }
  .footer-credits {
    font-style: italic;
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 540px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
