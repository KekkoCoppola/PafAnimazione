---
import { Icon } from 'astro-icon/components';
---

<section class="hero" id="home">
  <!-- Stars background -->
  <div class="stars-bg" aria-hidden="true">
    {Array.from({ length: 24 }).map((_, i) => (
      <span class={`star star-${i % 6}`} style={`--i:${i}`}><Icon name="fa6-solid:star" /></span>
    ))}
  </div>

  <!-- Burst rings -->
  <div class="burst" aria-hidden="true">
    <div class="burst-ring r1"></div>
    <div class="burst-ring r2"></div>
    <div class="burst-ring r3"></div>
  </div>

  <div class="container hero-content">
    <div class="hero-logo-wrap">
      <img src={`${import.meta.env.BASE_URL}logo.jpg`} alt="Paf Animazione Logo" class="hero-logo" width="260" height="260" />
    </div>

    <div class="hero-text">
      <div class="hero-tag"><Icon name="fa6-solid:wand-magic-sparkles" style="display:inline;vertical-align:middle;margin-right:0.25rem;" /> Animazione per ogni occasione</div>
      <h1 class="hero-title">
        La festa<br />
        <span class="highlight">comincia<br />con PAF!</span>
      </h1>
      <p class="hero-subtitle">
        Animatori professionisti, spettacoli su misura e momenti indimenticabili
        per feste, compleanni, matrimoni ed eventi aziendali.
      </p>
      <div class="hero-actions">
        <a href="#catalogo" class="btn btn-glass btn-xl">
          <Icon name="fa6-solid:champagne-glasses" style="margin-right:0.5rem;" /> Richiedi preventivo
        </a>
        <a href="#catalogo" class="btn btn-primary btn-xl">
          Scopri i servizi
        </a>
      </div>

      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num" data-target="500">0</span>
          <span class="stat-label">eventi all'anno</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num" data-target="15">0</span>
          <span class="stat-label">animatori</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num" data-target="10">0</span>
          <span class="stat-label">anni di esperienza</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <span>Scorri</span>
    <div class="scroll-arrow"></div>
  </div>
</section>

<style>
.hero {
  min-height: 100vh;
  background: var(--black);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding-top: 90px;
}

/* ── Stars ──────────────── */
.stars-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.star {
  position: absolute;
  font-size: 1.5rem;
  animation: starFloat 4s ease-in-out infinite;
  animation-delay: calc(var(--i) * 0.35s);
  color: var(--yellow);
  opacity: 0.7;
}

/* Distribute stars across the viewport */
.star-0 { top: 10%; left: 5%;  font-size: 1.2rem; }
.star-1 { top: 20%; left: 88%; font-size: 2rem;   }
.star-2 { top: 45%; left: 92%; font-size: 1rem;   }
.star-3 { top: 75%; left: 8%;  font-size: 1.8rem; }
.star-4 { top: 85%; left: 80%; font-size: 1.1rem; }
.star-5 { top: 60%; left: 3%;  font-size: 0.9rem; }



@keyframes starFloat {
  0%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
  50%       { transform: translateY(-20px) rotate(20deg) scale(1.2); }
}

/* ── Burst ──────────────── */
.burst {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}
.burst-ring {
  position: absolute;
  border-radius: 50%;
  border: 2px solid var(--yellow);
  opacity: 0.08;
  animation: pulse 3s ease-out infinite;
}
.r1 { width: 400px; height: 400px; margin: -200px; animation-delay: 0s; }
.r2 { width: 700px; height: 700px; margin: -350px; animation-delay: 1s; }
.r3 { width: 1000px;height: 1000px;margin: -500px; animation-delay: 2s; }

@keyframes pulse {
  0%   { transform: scale(0.8); opacity: 0.12; }
  100% { transform: scale(1.2); opacity: 0; }
}

/* ── Content ──────────────── */
.hero-content {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 4rem;
  align-items: center;
  position: relative;
  z-index: 2;
  padding-top: 2rem;
  padding-bottom: 4rem;
}

.hero-logo-wrap {
  position: relative;
}
.hero-logo {
  width: clamp(180px, 22vw, 280px);
  height: auto;
  border-radius: 50%;
  border: 4px solid var(--yellow);
  box-shadow: 0 0 0 8px rgba(255,225,53,0.15), 8px 8px 0 var(--yellow);
  animation: logoFloat 5s ease-in-out infinite;
  object-fit: cover;
}
@keyframes logoFloat {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50%       { transform: translateY(-12px) rotate(2deg); }
}

.hero-tag {
  display: inline-block;
  font-family: var(--font-display);
  font-size: 1rem;
  background: var(--yellow);
  color: var(--black);
  border: var(--border);
  padding: 0.3rem 1.2rem;
  border-radius: var(--radius-full);
  margin-bottom: 1.5rem;
  animation: fadeDown 0.8s ease both;
}

.hero-title {
  color: var(--white);
  margin-bottom: 1.5rem;
  animation: fadeDown 0.8s 0.15s ease both;
}
.hero-title .highlight {
  color: var(--yellow);
  position: relative;
}
.hero-title .highlight::after {
  content: '';
  position: absolute;
  bottom: 4px;
  left: 0;
  width: 100%;
  height: 6px;
  background: var(--orange);
  border-radius: 3px;
  z-index: -1;
}

.hero-subtitle {
  color: rgba(250,250,250,0.75);
  font-size: clamp(1rem, 1.5vw, 1.2rem);
  max-width: 520px;
  margin-bottom: 2.5rem;
  animation: fadeDown 0.8s 0.3s ease both;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 3rem;
  animation: fadeDown 0.8s 0.45s ease both;
}

.btn-xl {
  font-size: 1.15rem;
  padding: 0.85rem 2.2rem;
}

.btn-glass {
  background: rgba(255,255,255,0.1);
  backdrop-filter: blur(10px);
  border: 2px solid rgba(255,255,255,0.2);
  color: var(--white);
  box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}
.btn-glass:hover {
  background: rgba(255,255,255,0.2);
  border-color: rgba(255,255,255,0.4);
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.3);
}

/* ── Stats ──────────────── */
.hero-stats {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  animation: fadeDown 0.8s 0.6s ease both;
}
.stat {
  display: flex;
  flex-direction: column;
}
.stat-num {
  font-family: var(--font-display);
  font-size: 2.5rem;
  color: var(--yellow);
  line-height: 1;
}
.stat-num::after { content: '+'; font-size: 1.5rem; }
.stat-label {
  font-size: 0.8rem;
  color: rgba(250,250,250,0.6);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.stat-divider {
  width: 2px;
  height: 48px;
  background: rgba(255,225,53,0.3);
  border-radius: 1px;
}

/* ── Scroll indicator ──── */
.scroll-indicator {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  color: rgba(250,250,250,0.4);
  font-size: 0.75rem;
  font-family: var(--font-display);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  animation: scrollBounce 2s ease infinite;
}
.scroll-arrow {
  width: 20px;
  height: 20px;
  border-right: 2px solid rgba(255,225,53,0.5);
  border-bottom: 2px solid rgba(255,225,53,0.5);
  transform: rotate(45deg);
}
@keyframes scrollBounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50%       { transform: translateX(-50%) translateY(8px); }
}

/* ── Animations ──────────── */
@keyframes fadeDown {
  from { opacity: 0; transform: translateY(-24px); }
  to   { opacity: 1; transform: none; }
}

/* ── Responsive ──────────── */
@media (max-width: 768px) {
  .hero-content {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 2rem;
  }
  .hero-logo-wrap { display: flex; justify-content: center; }
  .hero-actions { justify-content: center; }
  .hero-stats { justify-content: center; }
  .hero-subtitle { margin-left: auto; margin-right: auto; }
}
</style>

<script>
  // Counter animation
  const counters = document.querySelectorAll('.stat-num');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      const target = parseInt(el.dataset.target || '0');
      let current = 0;
      const step = target / 60;
      const timer = setInterval(() => {
        current = Math.min(current + step, target);
        el.textContent = Math.round(current).toString();
        if (current >= target) clearInterval(timer);
      }, 25);
      observer.unobserve(el);
    });
  }, { threshold: 0.5 });

  counters.forEach((c) => observer.observe(c));
</script>
