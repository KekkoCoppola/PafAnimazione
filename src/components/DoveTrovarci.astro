---
import { Icon } from "astro-icon/components";
---

<section class="dove" id="dove">
  <div class="container">
    <div class="dove-header reveal">
      <span class="section-tag"
        ><Icon
          name="fa6-solid:location-dot"
          style="display:inline;vertical-align:middle;margin-right:0.25rem;"
        /> Dove Trovarci</span
      >
      <h2 class="section-title">Siamo qui per te</h2>
    </div>

    <div class="dove-layout">
      <!-- Map embed -->
      <div class="dove-map-container reveal">
        <div class="dove-map">
          <iframe
            src="https://maps.google.com/maps?q=40.8676668,14.4383905&hl=it&z=18&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          >
          </iframe>
        </div>
      </div>

      <!-- Info cards -->
      <div class="dove-info reveal" style="--delay:0.2s">
        <div class="info-card">
          <div class="info-icon"><Icon name="fa6-solid:house" /></div>
          <div>
            <h3>Sede Operativa</h3>
            <p>Via S. Giovanni de Matha, 7, 80049 Somma Vesuviana (NA)</p>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon"><Icon name="fa6-solid:clock" /></div>
          <div>
            <h3>Orari Ufficio</h3>
            <p>
              Lun – Ven: <strong>15:00 – 20:00</strong><br />
              Sab - Dom: Chiuso
            </p>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon"><Icon name="fa6-solid:phone" /></div>
          <div>
            <h3>Emergenze e Urgenze</h3>
            <p>
              Per richieste urgenti o conferme last-minute,<br />chiamaci
              direttamente al <a href="tel:+393318174419" class="phone-link"
                >+39 331 817 4419</a
              >
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dove {
    background: var(--yellow-soft);
    position: relative;
  }
  .dove::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: repeating-linear-gradient(
      90deg,
      var(--orange) 0,
      var(--orange) 40px,
      var(--black) 40px,
      var(--black) 44px
    );
  }

  .dove-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .dove-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* Map */
  .dove-map-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .dove-map {
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    aspect-ratio: 4/3;
    background: var(--white);
  }
  .map-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: linear-gradient(
      135deg,
      var(--gray-100) 0%,
      var(--gray-200) 100%
    );
  }
  .map-pin {
    font-size: 3rem;
    animation: bounce 2s ease infinite;
  }
  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }
  .map-placeholder p {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--black);
  }
  .map-placeholder small {
    color: var(--gray-600);
    font-size: 0.85rem;
  }
  .map-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .map-link-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0.75rem 1.5rem;
    background: var(--white);
    color: var(--black);
    border: var(--border);
    border-radius: 50px;
    box-shadow: 4px 4px 0 var(--black);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .map-link-btn:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--black);
    background: var(--yellow);
  }
  .map-icon {
    font-size: 1.25rem;
  }

  /* Info cards */
  .dove-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .info-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-bounce);
  }
  .info-card:hover {
    transform: translate(-3px, -3px);
  }
  .info-card--yellow {
    background: var(--yellow);
  }
  .info-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
  }
  .info-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
    color: var(--black);
  }
  .info-card p {
    font-size: 0.9rem;
    color: var(--black-soft);
    line-height: 1.5;
  }
  .phone-link {
    color: var(--orange);
    font-weight: 600;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .dove-layout {
      grid-template-columns: 1fr;
    }
    .dove-map {
      aspect-ratio: 16/9;
    }
  }
</style>
